<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rock" params="name x y z sx sy sz r g b">
    <model name="${name}">
      <static>true</static>
      <pose>${x} ${y} ${z} 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
          <material>
            <ambient>${r} ${g} ${b} 1</ambient>
            <diffuse>${r} ${g} ${b} 1</diffuse>
          </material>
          <scale>${sx} ${sy} ${sz}</scale>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>1.0</radius></sphere></geometry>
          <scale>${sx} ${sy} ${sz}</scale>
        </collision>
      </link>
    </model>
  </xacro:macro>

  <world name="mars_world">
    <gravity>0 0 -3.71</gravity>
    <scene>
      <ambient>0.6 0.45 0.35 1</ambient>
      <background>0.85 0.55 0.42 1</background>
    </scene>

    <model name="sun"><static>true</static>
      <link name="link"><light name="sun_light" type="directional">
        <cast_shadows>true</cast_shadows>
        <pose>0 0 20 0 0 0</pose>
        <diffuse>1 0.93 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <direction>-0.5 0.2 -0.8</direction>
      </light></link>
    </model>

    <model name="mars_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
        </collision>
        <visual name="ground_vis">
          <geometry><plane><normal>0 0 1</normal><size>120 120</size></plane></geometry>
          <material>
            <ambient>0.75 0.38 0.24 1</ambient>
            <diffuse>0.8 0.42 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_wall_1">
      <static>true</static>
      <pose>6 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 8 1.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 8 1.5</size></box></geometry>
          <material><ambient>0.35 0.2 0.15 1</ambient><diffuse>0.35 0.2 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_tower">
      <static>true</static>
      <pose>2.5 -3.2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.9</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.9</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.28 0.16 0.11 1</ambient><diffuse>0.28 0.16 0.11 1</diffuse></material>
        </visual>
      </link>
    </model>

    <xacro:rock name="rock_red_big" x="1.2" y="1.8" z="0.7" sx="0.9" sy="0.8" sz="0.7" r="0.70" g="0.30" b="0.22"/>
    <xacro:rock name="rock_gray_flat" x="3.2" y="-0.8" z="0.35" sx="1.3" sy="1.1" sz="0.35" r="0.50" g="0.50" b="0.52"/>
    <xacro:rock name="rock_yellow_small" x="4.8" y="2.1" z="0.25" sx="0.35" sy="0.30" sz="0.25" r="0.72" g="0.62" b="0.30"/>
    <xacro:rock name="rock_dark_tall" x="5.0" y="-2.4" z="0.6" sx="0.45" sy="0.45" sz="0.9" r="0.24" g="0.22" b="0.21"/>
    <xacro:rock name="rock_blue_mid" x="2.0" y="-1.9" z="0.4" sx="0.60" sy="0.50" sz="0.4" r="0.33" g="0.39" b="0.55"/>
    <xacro:rock name="rock_orange_mid" x="3.5" y="2.9" z="0.45" sx="0.55" sy="0.45" sz="0.45" r="0.73" g="0.45" b="0.24"/>
    <xacro:rock name="rock_shield_1" x="4.2" y="0.8" z="0.55" sx="1.1" sy="0.5" sz="0.55" r="0.43" g="0.31" b="0.21"/>
    <xacro:rock name="rock_shield_2" x="4.3" y="-0.9" z="0.45" sx="1.0" sy="0.4" sz="0.45" r="0.40" g="0.28" b="0.20"/>

  </world>
</sdf>
