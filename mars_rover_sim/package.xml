<?xml version="1.0"?>
<package format="2">
  <name>mars_rover_sim</name>
  <version>0.1.0</version>
  <description>Mars-like Gazebo simulation with rover, SLAM, and obstacle-aware path planning.</description>

  <maintainer email="dev@example.com">codex</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>xacro</depend>
  <depend>gazebo_ros</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>rviz</depend>

  <exec_depend>orb_slam2_ros</exec_depend>
</package>
