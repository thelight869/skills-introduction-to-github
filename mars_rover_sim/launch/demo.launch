<launch>
  <arg name="enable_orbslam" default="false"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="-1.5"/>
  <arg name="z" default="0.2"/>

  <include file="$(find mars_rover_sim)/launch/sim.launch">
    <arg name="enable_orbslam" value="$(arg enable_orbslam)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
  </include>

  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find mars_rover_sim)/config/mars_demo.rviz"/>
</launch>
